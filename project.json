{
  "name": "ragpolyglot",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "debug-infra": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f docker-compose.debug.yml -p ragpolyglot-debug up -d --wait"
      }
    },
    "debug-infra-down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f docker-compose.debug.yml -p ragpolyglot-debug down"
      }
    }
  }
}
