# Safe to commit. Used by: docker compose --profile test --env-file .env --env-file .env.test.example
# Points rag-worker at llm-stub instead of LM Studio.
LMSTUDIO_API_URL=http://llm-stub:8090/v1
LLM_MODEL=test-model
EMBEDDING_FALLBACK=true
STUB_LLM_ANSWER=Integration test answer from stub LLM.
STUB_DELAY_MS=3000
