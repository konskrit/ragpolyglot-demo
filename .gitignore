# =============================================================================
# RAGPolyglot — senior-safe .gitignore
# Keep secrets, build artifacts, local tooling, and OS junk out of VCS.
# =============================================================================

# ----- Secrets & local env (track only *.example) -----
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.p12
*.pfx
*.key
*.crt
id_rsa
id_rsa.pub
*.secret
*.secrets
credentials.json
service-account*.json
**/secrets/
**/secret/

# ----- Dependencies -----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----- Nx / JS / TS build & cache -----
/dist/
**/dist/
/tmp/
/out-tsc/
/build/
.nx/cache
.nx/workspace-data
.nx/installation
.angular/
.vite/
vite.config.*.timestamp*
*.tsbuildinfo
.eslintcache
.stylelintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ----- Test / coverage -----
/coverage/
/apps/**/coverage/
/libs/**/coverage/
.nyc_output/
**/TestResults/
**/test-results/
**/playwright-report/
**/blob-report/
**/playwright/.cache/

# ----- .NET -----
**/bin/
**/obj/
**/out/
**/artifacts/
**/publish/
*.user
*.userosscache
*.suo
*.rsuser
*.sln.docstates
project.lock.json
project.fragment.lock.json
artifacts/
packages/
.vs/
*.nupkg
*.snupkg
appsettings.Local.json
appsettings.*.local.json

# ----- Go -----
**/vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.html
*.coverprofile
*.prof
__debug_bin*
apps/rag-worker/rag-worker
apps/event-processor/event-processor
go.work
go.work.sum

# ----- App runtime data (local RAG uploads / vectors dumps) -----
/uploads/
**/uploads/
!**/uploads/.gitkeep
*.sqlite
*.sqlite3
*.db

# ----- Docker / compose local overrides -----
docker-compose.override.yml
docker-compose*.local.yml
.docker/

# ----- IDE / editors -----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.project
.classpath
.settings/
*.code-workspace

# ----- OS junk -----
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- AI / agent local state (do not commit session dumps) -----
.continue/
.cursor/
!.cursor/rules/
!.cursor/commands/
**/agent-transcripts/
**/.claude/

# AI agent instruction / prompt markdown (local tooling, not product docs)
AGENTS.md
AI.md
CLAUDE.md
COPILOT.md
GEMINI.md
.cursorrules
.cursorignore
**/.github/copilot-instructions.md
**/PROMPT.md
**/PROMPTS.md

# ----- Misc local tooling -----
*.local
.turbo/
.cache/
.parcel-cache/
.vercel/
.netlify/
