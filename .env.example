# Runtime
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgresql:5432/app_db?sslmode=disable
ConnectionStrings__Default=Host=postgresql;Port=5432;Database=app_db;Username=postgres;Password=postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_MANAGEMENT_PORT=15672

# Document service
DOCUMENT_SERVICE_PORT=5000
ASPNETCORE_URLS=http://+:5000

# RAG worker
RAG_WORKER_PORT=8081
RAG_WORKER_HTTP_ADDR=:8081
RAG_WORKER_URL=http://rag-worker:8081
EMBEDDING_FALLBACK=false
EMBEDDING_MODEL=text-embedding-ada-002
# Must match your embedding API output (768 for many LM Studio models; 1536 for ada-002). Baked into pgvector column at schema init.
EMBEDDING_DIMENSION=768
MAX_EXTRACTED_CHARS=10000000
MAX_CHUNKS=5000

# RAG worker pools / parallelism (unset = code defaults; compose defaults below match local Docker)
# WORK_POOL_SLOTS=4              # base OCR slots when OCR_POOL_SLOTS unset
# WORK_POOL_CPU_RATIO=0.8        # CPU fraction when WORK_POOL_SLOTS unset (bare-metal)
# OCR_POOL_SLOTS=                # override OCR page slots (default: WORK_POOL_SLOTS)
# EMBED_POOL_SLOTS=2             # parallel embed batches
# WORK_MEMORY_BUDGET_MB=4096     # OCR pool memory cap
# EMBED_MEMORY_BUDGET_MB=         # embed pool memory cap (default: 2 × EMBED_POOL_SLOTS × EMBED_BATCH_MEMORY_MB)
# OCR_PAGE_MEMORY_MB=64          # estimated RAM per OCR page task
# EMBED_BATCH_MEMORY_MB=32       # estimated RAM per embed batch task
# OCR_RENDER_DPI=150             # pdftoppm resolution (150=fast, 200=sharper)
# KRAKEN_GRC_MODEL=/models/grc.mlmodel  # CLLG polytonic Greek model (kraken CLI)
# INSTALL_OCR_LANGS=1            # docker build: extra tessdata_fast langs (0 in CI)
# INSTALL_KRAKEN=1               # docker build: Kraken + torch (0 in CI)
# KRAKEN_TORCH=cu124             # docker build: cu124 (GPU-capable torch) or cpu (smaller CI image)
# KRAKEN_DEVICE=cuda:0           # GPU first; falls back to cpu if CUDA is missing or Kraken fails on GPU
# KRAKEN_GPU_CONCURRENT=2        # parallel kraken CUDA subprocesses (default: OCR_INGEST_PREFETCH; split VRAM budget)
# KRAKEN_BATCH_PAGES=64          # pages per kraken subprocess (16 on CPU; CUDA default 64)
# KRAKEN_THREADS=16              # OpenMP threads inside kraken (empty = min(CPU, 8))
# KRAKEN_PRECISION=              # empty: bf16-mixed on CUDA, kraken default on CPU
# KRAKEN_LINE_BATCH=             # empty: 256 on CUDA (lines per GPU forward pass; raise if VRAM is underused)
# KRAKEN_LINE_WORKERS=           # empty: min(CPU, 16) on CUDA (CPU line prep; Kraken 7 throughput knob)
# KRAKEN_VRAM_BUDGET_MB=16384    # caps page batch on GPU (batch <= budget / KRAKEN_VRAM_PAGE_MB)
# KRAKEN_VRAM_PAGE_MB=256        # estimated VRAM per page when sizing GPU batches
# KRAKEN_PAGE_MEMORY_MB=256      # RAM reservation for one pdftoppm page in the OCR pool
# OCR_RENDER_DPI=150             # lower (e.g. 120) speeds pdftoppm if scans are clean
# GPU: rag-worker uses `gpus: all` (NVIDIA Container Toolkit). Kraken falls back to CPU if CUDA is unavailable.
# FAST_INGEST_PREFETCH=4         # concurrent fast-path ingests (txt, native PDF, embed)
# OCR_INGEST_PREFETCH=2          # max documents in Kraken OCR at once (match KRAKEN_GPU_CONCURRENT on one GPU)
# INGEST_PREFETCH=               # legacy alias for OCR_INGEST_PREFETCH

# Failed document auto-retry (document-service + event-processor scheduler)
# AUTO_RETRY_INTERVAL_MINUTES=1  # how often event-processor queues auto-retry job
# AUTO_RETRY_MIN_AGE_MINUTES=1   # min time failed before eligible
# AUTO_RETRY_MAX_RETRIES=3       # per-document retry cap
# AUTO_RETRY_LIMIT=10            # max documents per auto-retry run

# LLM
LMSTUDIO_API_URL=http://host.docker.internal:1234/v1
LLM_MODEL=local-model
# OPENAI_API_KEY=
# OPENAI_API_BASE_URL=

# Event processor
EVENT_PROCESSOR_PORT=8082
EVENT_PROCESSOR_HTTP_ADDR=:8082
EVENT_PROCESSOR_URL=http://event-processor:8082
LOG_RETENTION_DAYS=30

# API gateway
PORT=3000
GATEWAY_PORT=3000
DOCUMENT_SERVICE_URL=http://document-service:5000
UPLOADS_DIR=/uploads
MAX_UPLOAD_BYTES=314572800
# nginx client_max_body_size (apps/react-frontend/nginx.conf) must match when using the UI image.
HTTP_TIMEOUT_MS=10000
RAG_CACHE_TTL_SECONDS=600
RAG_TOP_K=5

# Frontend
VITE_API_URL=
VITE_WS_URL=
FRONTEND_PORT=4200

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@demo.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_LISTEN_PORT=80
